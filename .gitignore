# ---- Experiment outputs ----
# Raw trajectories are large and regenerable from configs + seeds + code version.
# They are NOT committed; reproducibility comes from configs, the runbook, and
# the commands recorded in docs/research_log.md. Raw files are immutable on disk
# and hash-manifested (data/raw/<run_id>/manifest.json).
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Phase 0 artifacts: keep the small JSON reports as provenance, exclude bulky
# evaluator dumps.
# (directories must be re-included before files inside them can be)
artifacts/**
!artifacts/phase0/
!artifacts/phase0/*/
!artifacts/phase0/.gitkeep
!artifacts/phase0/*/phase0_report.json
!artifacts/phase0/*/snapshot.json
!artifacts/phase0_5/
!artifacts/phase0_5/call_ledger.json
!artifacts/phase0_5/global_provider_attempts.json
!artifacts/phase0_5/gemini_2_5_flash_call_ledger.json
!artifacts/phase0_5/gemini_2_5_flash_preflight.json
!artifacts/phase0_5/gemini_2_5_flash_eligibility_finding.json
!artifacts/phase0_5/provider_metadata_requests.json
!artifacts/phase0_5/availability/
!artifacts/phase0_5/availability/*.json
!artifacts/phase0_5/gemini_3_6_flash_call_ledger.json
!artifacts/phase0_5/scientific_run_dispositions.json
!artifacts/phase0_5/token_accounting_live_verification.json
# Phase 0.5 real-agent runs: small JSON provenance only, not evaluator dumps.
!artifacts/phase0_5/phase05-gemini36-*/
!artifacts/phase0_5/phase05-gemini36-*/phase05_report.json
!artifacts/phase0_5/phase05-gemini36-*/feature_audit.json
!artifacts/phase0_5/phase05-gemini36-*/baseline/
!artifacts/phase0_5/phase05-gemini36-*/baseline/baseline_check.json

results/**
!results/.gitkeep
!results/README.md

# Scratch
scratch/
tmp/
*.log

# ---- Paper build ----
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.out
paper/**/*.toc
paper/**/*.synctex.gz
paper/**/*.fdb_latexmk
paper/**/*.fls
!results/paper/
!results/paper/*.json

# Censoring-study evidence files (small JSON/CSV/parquet) are part of the artifact.
!results/censoring/
!results/censoring/**

# Local reference build of the submission PDF (Overleaf output is authoritative).
!tas_overleaf/main_reference_build.pdf
